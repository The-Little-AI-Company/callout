{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": { "@engine/*": ["./engine/*"], "@content/*": ["./content/*"] },
    "baseUrl": "."
  },
  "include": ["engine", "src", "test", "content/*.ts"],
  "exclude": ["node_modules", "dist", "src-tauri", "site"]
}
