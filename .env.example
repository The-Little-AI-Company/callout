# Developer keys for tests and the eval script ONLY.
# The shipped app never reads this file: testers paste keys into Settings and
# they are stored in Windows Credential Manager (docs/SETUP.md).
#
# Copy to .env (git-ignored) and fill in what you have.

# Required for the fast lane and every judgment. https://console.typesafe.ai
TYPESAFE_API_KEY=

# Web search for the deep lane. https://app.tavily.com
TAVILY_API_KEY=

# LLM helper. Default provider is DeepSeek. https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Landing page signup function (site/api/signup.ts), deployed separately.
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=
# SIGNUP_FROM="Callout <beta@yourdomain>"
# SIGNUP_INBOX=
# SIGNUP_CAP=20
